# Obligatoria en producción. Lista separada por comas, sin comodines.
ALLOWED_ORIGINS=https://pdf.example.com

# Cantidad exacta de proxies confiables entre Internet y Node. 0 = ninguno.
TRUST_PROXY_HOPS=1

# Activar solo cuando el dominio completo funciona exclusivamente por HTTPS.
ENABLE_HSTS=true

PORT=3000
MAX_ACTIVE_SESSIONS=100
MAX_STORAGE_BYTES=1073741824
SESSION_IDLE_TTL_MS=7200000
ADMIN_SESSION_TTL_MS=28800000
